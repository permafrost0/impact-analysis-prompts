# 設計書(社内の資料なので、リポジトリに入れない)
input/target/*
!input/target/.gitkeep
input/reference/*
!input/reference/.gitkeep

# input/source/(調査するソースの置き場所)は、あえてここに書いていない。
# .gitignore に書くと、Copilot のテキスト検索の対象から外れ、エージェントがソースを検索できなくなるため。
# このフォルダを git で管理している場合は、input/source/ の中身をコミットしないこと。

# 調査の作業フォルダと成果物(各自の PC の中だけで使う)
work/runs/*
!work/runs/.gitkeep

# 差し戻し・修正の蓄積(各自の PC の中だけで使う)
history/*
!history/.gitkeep

# Python
__pycache__/
*.pyc

# Excel の一時ファイル
~$*
